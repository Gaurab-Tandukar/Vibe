# Server
PORT=3000
NODE_ENV=development

# Database — MongoDB Atlas connection string (or local MongoDB URI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d

# Message encryption — used to encrypt message content at rest
MESSAGE_ENCRYPTION_KEY=replace_with_a_long_random_string

# CORS — the deployed frontend origin (no trailing slash). Also allows
# localhost:5173 / localhost:3000 automatically for local development.
CLIENT_URL=https://your-frontend-domain.com
